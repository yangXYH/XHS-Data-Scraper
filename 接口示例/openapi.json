    "/tasks/{id}/files/{index}": {
      "get": {
        "operationId": "get_tasks_id_files_index",
        "summary": "下载服务器已保存的文件",
        "tags": [
          "任务"
        ],
        "description": "使用任务返回的 download_url；仍需 Bearer 密钥。index 从 0 开始，与创建任务的 index（从1开始）不同。文件以流方式返回。",
        "responses": {
          "200": {
            "description": "成功",
