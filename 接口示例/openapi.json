{
  "openapi": "3.1.0",
  "info": {
    "title": "小红书下载服务 · 开放接口",
    "version": "1.0.0",
    "description": "可供脚本和其他应用调用的真实接口。先获取管理员提供的 API Key，点击 Authorize 输入密钥（不含 Bearer 前缀）。创建任务后轮询状态；done 成功，warning 部分成功，failed 失败，cancelled 已停止。文件保存到服务器选定目录，调用者通过文件接口获取到自己的电脑。"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "当前服务器"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "由服务器管理员提供的持久 API Key，不是浏览器页面令牌。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "TaskInput": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "单篇笔记完整URL（含原有 xsec_token），也支持 xhslink.com 短链。"
          },
          "mode": {
            "type": "string",
            "enum": [
              "download",
              "parse"
            ],
            "default": "download"
          },
          "index": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "default": [],
            "description": "要保存的资源序号，从1开始；空数组表示全部。"
          },
          "reuse": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "status_url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "status_url"
        ],
        "additionalProperties": false
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "cancelling",
              "done",
              "warning",
              "failed",
              "cancelled"
            ]
          },
          "message": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "collection_id": {
            "type": "string"
          },
          "current": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "created": {
            "type": "number"
          },
          "finished": {
            "type": [
              "number",
              "null"
            ]
          },
          "resource_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "files",
          "resource_urls"
        ],
        "additionalProperties": false
      },
      "File": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "download_url": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "name",
          "size",
          "download_url"
        ],
        "additionalProperties": false
      },
      "Collection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "starting",
              "scanning",
              "login",
              "attention",
              "complete",
              "partial",
              "failed",
              "cancelled"
            ]
          },
          "message": {
            "type": "string"
          },
          "note_count": {
            "type": "integer"
          },
          "complete": {
            "type": "boolean"
          },
          "notes_url": {
            "type": "string"
          },
          "downloads": {
            "type": "object"
          },
          "created": {
            "type": "number"
          },
          "finished": {
            "type": "number"
          }
        }
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "TaskPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "total": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ],
        "additionalProperties": false
      },
      "CollectionPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Collection"
            }
          },
          "total": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ],
        "additionalProperties": false
      },
      "NotePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Note"
            }
          },
          "total": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ],
        "additionalProperties": false
      }
    }
  },
